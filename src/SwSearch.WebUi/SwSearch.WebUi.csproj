<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\webui\**\*">
      <Link>webui\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    The taskpane already owns the hardened ExplorerBrowser/IResultsFolder host
    used for real Shell items.  Compile that source into the modern desktop
    Web UI assembly as well rather than referencing the legacy .NET Framework
    add-in binary.  It has no SOLIDWORKS API dependency: only WinForms and the
    Windows Shell COM contracts live in this file.
  -->
  <ItemGroup>
    <Compile Include="..\SwSearch.SolidWorksAddin\TaskpaneShellResultsHost.cs"
             Link="Native\Shell\TaskpaneShellResultsHost.cs" />
    <!-- Shared UI-language resolver, source-linked like WindowsScopePath. -->
    <Compile Include="..\Shared\UiLanguage.cs" Link="UiLanguage.cs" />
  </ItemGroup>

  <!-- The SDK package references both WinForms and WPF facades on modern .NET.
       This host uses only Core composition APIs; removing the unused WPF facade
       avoids its legacy WindowsBase reference while retaining package-native loader assets. -->
  <Target Name="RemoveUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_UnusedWebView2WpfReference Include="@(Reference)"
          Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
      <Reference Remove="@(_UnusedWebView2WpfReference)" />
    </ItemGroup>
  </Target>
</Project>

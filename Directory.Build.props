<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>1.3.17</Version>
    <AssemblyVersion>1.3.17.0</AssemblyVersion>
    <FileVersion>1.3.17.0</FileVersion>
    <InformationalVersion>1.3.17</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <BaseOutputPath Condition="'$(SwSearchIsolatedBuildRoot)' != ''">$(SwSearchIsolatedBuildRoot)\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(SwSearchIsolatedBuildRoot)' != ''">$(SwSearchIsolatedBuildRoot)\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath Condition="'$(SwSearchIsolatedBuildRoot)' != ''">$(SwSearchIsolatedBuildRoot)\obj\$(MSBuildProjectName)\</MSBuildProjectExtensionsPath>
    <DefaultItemExcludes Condition="'$(SwSearchIsolatedBuildRoot)' != ''">$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\**;$(MSBuildProjectDirectory)\bin\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup Condition="'$(SwSearchFrozenRuntimeGraph)' == 'true'">
    <!--
      The release is framework-dependent, but the frozen restore transaction
      deliberately records all three machine framework packs used by installer
      prerequisite checks.  Keeping these as exact PackageDownload entries
      makes the no-restore candidate graph deterministic without copying the
      runtimes into the product payload.
    -->
    <PackageDownload Include="Microsoft.AspNetCore.App.Runtime.win-x64" Version="[8.0.27]" />
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.win-x64" Version="[8.0.27]" />
    <PackageDownload Include="Microsoft.WindowsDesktop.App.Runtime.win-x64" Version="[8.0.27]" />
  </ItemGroup>
</Project>

<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>SwSearch-Setup-x64</OutputName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <DefineConstants>$(DefineConstants);MsiPath=$(MsiPath);ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Bundle.wxs" />
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
  </ItemGroup>
  <Target Name="BlockRetiredBundle" BeforeTargets="Build">
    <Error Text="The Burn bootstrapper is retired after incident 2026-07-14. Build installer/Build-Msi.ps1 instead." />
  </Target>
</Project>

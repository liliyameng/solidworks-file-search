    <_ActualMSBuildExtensionsPath Condition="'$(MSBuildExtensionsPath)' != ''">$([System.IO.Path]::GetFullPath('$(MSBuildExtensionsPath)'))</_ActualMSBuildExtensionsPath>
    <_ActualMSBuildUserExtensionsPath Condition="'$(MSBuildUserExtensionsPath)' != ''">$([System.IO.Path]::GetFullPath('$(MSBuildUserExtensionsPath)'))</_ActualMSBuildUserExtensionsPath>
    <_ActualMSBuildUserExtensionsPathUpper Condition="'$(_ActualMSBuildUserExtensionsPath)' != ''">$([System.String]::Copy('$(_ActualMSBuildUserExtensionsPath)').ToUpperInvariant())</_ActualMSBuildUserExtensionsPathUpper>

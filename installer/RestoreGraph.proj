    <_ActualMSBuildUserExtensionsUnderTestResults Condition="'$(_ActualMSBuildUserExtensionsPathUpper)' != ''">$([System.String]::Copy('$(_ActualMSBuildUserExtensionsPathUpper)').StartsWith('$(_ExpectedTestResultsPathPrefixUpper)'))</_ActualMSBuildUserExtensionsUnderTestResults>

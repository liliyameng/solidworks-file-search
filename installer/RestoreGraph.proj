  <Target Name="ValidateRestoreBoundaries">
    <Error Condition="'$(RestoreConfigFile)' != '$(_ExpectedRestoreConfigFile)' Or '$(_ActualRestoreConfigFile)' != '$(_ExpectedRestoreConfigFile)'"
           Text="RestoreConfigFile must be the canonical frozen offline NuGet config." />
    <Error Condition="'$(RestorePackagesPath)' != '$(_ExpectedRestorePackagesPath)' Or '$(_ActualRestorePackagesPath)' != '$(_ExpectedRestorePackagesPath)'"
           Text="RestorePackagesPath must be the new RC48 r3 workspace package folder." />
    <Error Condition="'$(RestoreSources)' != '$(_ExpectedRestoreSources)' Or '$(_ActualRestoreSources)' != '$(_ExpectedRestoreSources)'"
           Text="RestoreSources must be the canonical workspace offline feed." />
    <Error Condition="'$(NUGET_PACKAGES)' != '$(_ExpectedRestorePackagesPath)' Or '$(_ActualNuGetPackages)' != '$(_ExpectedRestorePackagesPath)'"
           Text="NUGET_PACKAGES must be the same new RC48 r3 workspace package folder." />
    <Error Condition="'$(MSBuildSDKsPath)' != '$(_ExpectedMSBuildSDKsPath)' Or '$(_ActualMSBuildSDKsPath)' != '$(_ExpectedMSBuildSDKsPath)'"
           Text="MSBuildSDKsPath must resolve to the frozen .NET SDK 8.0.421 installation." />
    <Error Condition="'$(MSBuildExtensionsPath)' != '$(_ExpectedMSBuildExtensionsPath)' Or '$(_ActualMSBuildExtensionsPath)' != '$(_ExpectedMSBuildExtensionsPath)'"
           Text="MSBuildExtensionsPath must resolve to the frozen .NET SDK 8.0.421 installation." />

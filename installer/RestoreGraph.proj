           Text="MSBuildUserExtensionsPath must be the isolated evidence directory under the workspace TestResults root." />
    <Error Condition="'$(DirectoryBuildPropsPath)' != '$(_ExpectedDirectoryBuildPropsPath)' Or '$(_ActualDirectoryBuildPropsPath)' != '$(_ExpectedDirectoryBuildPropsPath)'"
           Text="DirectoryBuildPropsPath must resolve to the frozen workspace Directory.Build.props." />
    <Error Condition="'$(DirectoryBuildTargetsPath)' != ''"
           Text="DirectoryBuildTargetsPath must be empty for the frozen restore." />
    <Error Condition="'$(DirectoryPackagesPropsPath)' != ''"
           Text="DirectoryPackagesPropsPath must be empty for the frozen restore." />
    <Error Condition="'$(ImportDirectoryBuildTargets)' != 'false'"

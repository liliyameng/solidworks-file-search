  <PropertyGroup>
    <_ExpectedRestoreConfigFile>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)NuGet.Offline.config'))</_ExpectedRestoreConfigFile>
    <_ExpectedRestorePackagesPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\.packages-rc48-r3'))</_ExpectedRestorePackagesPath>
    <_ExpectedRestoreSources>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory).offline-feed'))</_ExpectedRestoreSources>
    <_ExpectedMSBuildSDKsPath>$([System.IO.Path]::GetFullPath('C:\Program Files\dotnet\sdk\8.0.421\Sdks'))</_ExpectedMSBuildSDKsPath>
    <_ExpectedMSBuildExtensionsPath>$([System.IO.Path]::GetFullPath('C:\Program Files\dotnet\sdk\8.0.421'))</_ExpectedMSBuildExtensionsPath>

           Text="ImportUserLocationsByWildcardAfterMicrosoftCSharpTargets must be false for the frozen restore." />
    <Error Condition="'$(ExcludeRestorePackageImports)' != 'true'"
           Text="ExcludeRestorePackageImports must be true for the frozen restore." />
    <Error Condition="'$(MSBuildEnableWorkloadResolver)' != 'false'"
           Text="MSBuildEnableWorkloadResolver must be false for the frozen restore." />
    <Error Condition="'$(RestoreNoCache)' != 'true'"
           Text="RestoreNoCache must be true for the frozen restore." />
    <Error Condition="'$(RestoreDisableParallel)' != 'true'"
           Text="RestoreDisableParallel must be true for the frozen restore." />
    <Error Condition="'$(RestoreForceEvaluate)' != 'true'"
           Text="RestoreForceEvaluate must be true for the frozen restore." />
    <Error Condition="'$(NuGetAudit)' != 'false'"
           Text="NuGetAudit must be false for the frozen restore." />
    <Error Condition="'$(RestoreIgnoreFailedSources)' != 'false'"
           Text="RestoreIgnoreFailedSources must be false for the frozen restore." />
    <Error Condition="'$(DisableImplicitNuGetFallbackFolder)' != 'true'"
           Text="DisableImplicitNuGetFallbackFolder must be true for the frozen restore." />
    <Error Condition="Exists('$(_ExpectedRestorePackagesPath)')"
           Text="The RC48 r3 workspace package folder must not exist before the one-shot restore." />
    <Error Condition="'$(RestoreAdditionalProjectSources)' != ''"
           Text="RestoreAdditionalProjectSources must be empty for the frozen restore." />
    <Error Condition="'$(RestoreFallbackFolders)' != ''"
           Text="RestoreFallbackFolders must be empty for the frozen restore." />
